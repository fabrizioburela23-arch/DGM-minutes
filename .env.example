# Copia este archivo como .env para trabajar en local. Nunca subas el .env a GitHub.
# En Railway estas variables se configuran en la pestaña Variables del servicio.

# Base de datos (Railway: referencia a Postgres.DATABASE_URL)
DATABASE_URL=

# IA (clave del espacio de trabajo "DGM Minutos" en Claude Console)
ANTHROPIC_API_KEY=
MODEL_SMALL=claude-haiku-5-5
MODEL_LARGE=claude-sonnet-5-5
CONFIDENCE_THRESHOLD=0.85

# Google Drive (cuenta de servicio dgm-drive-lector, JSON crudo o en base64)
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_ROOT_FOLDER_ID=
# form = una sola carpeta (Google Form); folders = subcarpeta por intérprete
DRIVE_LAYOUT=
# Ignorar archivos creados antes de esta fecha (AAAA-MM-DD)
DRIVE_SINCE=

# Bucket de imágenes (Railway: referencias al bucket coordinated-drawer)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Login de gerentes con Google (cliente OAuth "DGM Minutos web" del proyecto dgm-minutos)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Opcional: URL pública del dashboard (en Railway se deduce de RAILWAY_PUBLIC_DOMAIN)
AUTH_URL=
# Gerentes que pueden entrar (se agregan al desplegar; nunca se borran ni se reactivan). Separados por comas.
ADMIN_EMAILS=
MANAGER_EMAILS=
# Solo en tu computadora, con `pnpm dev`: entra como este correo sin Google. No tiene efecto en Railway.
DEV_LOGIN_EMAIL=

# Reglas (pendiente de confirmar con DGM)
APP_TIMEZONE=America/La_Paz
MAX_MINUTES_PER_DAY=720

# Datos de prueba (true = cargar 3 intérpretes ficticios al migrar)
SEED_TEST_DATA=
SEED_ADMIN_EMAIL=
