# Copia este archivo como .env para trabajar en local. Nunca subas el .env a GitHub.
# En Railway estas variables se configuran en la pestaña Variables del servicio.

# Base de datos (Railway: referencia a Postgres.DATABASE_URL)
DATABASE_URL=

# IA (clave del espacio de trabajo "DGM Minutos" en Claude Console)
ANTHROPIC_API_KEY=
MODEL_SMALL=claude-haiku-5-5
MODEL_LARGE=claude-sonnet-5-5
CONFIDENCE_THRESHOLD=0.85

# Google Drive (cuenta de servicio dgm-drive-lector, JSON crudo o en base64)
GOOGLE_SERVICE_ACCOUNT_JSON=
DRIVE_ROOT_FOLDER_ID=

# Bucket de imágenes (Railway: referencias al bucket coordinated-drawer)
S3_ENDPOINT=
S3_REGION=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Login de gerentes con Google (hito 5)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Reglas (pendiente de confirmar con DGM)
APP_TIMEZONE=America/La_Paz
MAX_MINUTES_PER_DAY=720
